{
  "name": "chat-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/ws": "^8.18.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.7",
    "typescript": "5.9.2",
    "web": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "ws": "^8.21.1"
  }
}
